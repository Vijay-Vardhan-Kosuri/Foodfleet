# FoodFleet Root Environment Example
# Copy backend/.env.example -> backend/.env and frontend/.env.example -> frontend/.env

# Backend Database (MySQL 8.0)
DB_ENGINE=mysql
DB_NAME=foodfleet_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Django Core
SECRET_KEY=replace-with-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS & Frontend Origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Razorpay Test Mode - leave blank to use built-in simulated gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Media Storage (set USE_CLOUDINARY=True and credentials to store uploads on Cloudinary)
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Demo Seed Accounts (Development Only)
ENABLE_DEMO_ACCOUNTS=True
